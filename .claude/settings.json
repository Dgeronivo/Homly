{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "cleanupPeriodDays": 30,
  "respectGitignore": true,
  "alwaysThinkingEnabled": true,
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(gradle:*)",
      "Bash(./gradlew:*)"
    ]
  }
}
